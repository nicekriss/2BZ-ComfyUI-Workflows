{
  "manifestVersion": 5,
  "id": "toobusy.photoshop.bridge",
  "name": "TooBusy AI",
  "version": "0.2.3",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "26.0.0",
    "data": {
      "apiVersion": 2
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "toobusyBridge",
      "label": {
        "default": "TooBusy AI"
      },
      "minimumSize": {
        "width": 260,
        "height": 300
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 320,
        "height": 680
      },
      "preferredFloatingSize": {
        "width": 360,
        "height": 680
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "dark",
            "darkest",
            "light",
            "lightest"
          ],
          "species": [
            "generic"
          ]
        }
      ]
    },
    {
      "type": "panel",
      "id": "toobusyInput",
      "label": {
        "default": "TooBusy · 입력 미리보기"
      },
      "minimumSize": {
        "width": 240,
        "height": 280
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 300,
        "height": 480
      },
      "preferredFloatingSize": {
        "width": 340,
        "height": 520
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "dark",
            "darkest",
            "light",
            "lightest"
          ],
          "species": [
            "generic"
          ]
        }
      ]
    },
    {
      "type": "panel",
      "id": "toobusyResults",
      "label": {
        "default": "TooBusy · 결과 미리보기"
      },
      "minimumSize": {
        "width": 260,
        "height": 320
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 320,
        "height": 540
      },
      "preferredFloatingSize": {
        "width": 380,
        "height": 600
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "dark",
            "darkest",
            "light",
            "lightest"
          ],
          "species": [
            "generic"
          ]
        }
      ]
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request",
    "ipc": {
      "enablePluginCommunication": true
    },
    "network": {
      "domains": "all"
    },
    "launchProcess": {
      "schemes": [
        "https"
      ],
      "extensions": [
        ".ccx"
      ]
    }
  },
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "all"
      ],
      "species": [
        "generic"
      ]
    }
  ]
}
